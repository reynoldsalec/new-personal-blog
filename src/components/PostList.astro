---
import { url, category, type Post } from '../lib/posts';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---
{posts.map(post => <article class="post-row" data-category={category(post)}>
  <time datetime={post.data.date.toISOString().slice(0,10)}>{post.data.date.toISOString().slice(0,10)}</time>
  <h2><a href={url(post)}>{post.data.title}</a></h2>
  <span class="meta category">{category(post)}</span><span class="arrow" aria-hidden="true">↗</span>
</article>)}
