---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Alec Reynolds', description = 'Notes on technology, community, and the places we share.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en"><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title === 'Alec Reynolds' ? title : `${title} — Alec Reynolds`}</title>
  <meta name="description" content={description} /><link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} /><meta property="og:type" content="website" />
  <link rel="alternate" type="application/rss+xml" title="Alec Reynolds RSS" href="/rss.xml" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head><body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="shell"><header class="site-header">
    <a class="mark" href="/" aria-label="Alec Reynolds home">ar.</a>
    <nav aria-label="Main"><a href="/#writing">Writing</a><a href="https://github.com/reynoldsalec">GitHub ↗</a></nav>
  </header><slot />
  <footer><span>Alec Reynolds</span><a href="/rss.xml">RSS</a><span>Independent thoughts. Open web.</span></footer></div>
</body></html>
